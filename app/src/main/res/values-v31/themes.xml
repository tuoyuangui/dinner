<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12 起系统接管启动画面：底色与图标从这里取。
        不写的话它默认拿 windowBackground + 应用图标，换主题时容易和桌面图标不一致。
    -->
    <style name="Theme.DinnerDesign" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>

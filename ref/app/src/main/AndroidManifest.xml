<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 记录「在哪吃」：只在保存记录时取一次，不订阅、不追踪。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Android 11+ 包可见性。授权页由百度 OAuth SDK 的 WebViewActivity 承载，
        不需要应用自己去找浏览器；但「我的 → 关于」里的项目主页、以及
        「去应用商店」这类跳转仍要声明，否则 resolveActivity 一律返回 null。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- 百度 OAuth SDK 的 SSO 入口：不声明这条 queries，Android 11+ 的包可见性
             会让 SDK 看不到百度 App，装了手百也只能退回网页授权。 -->
        <intent>
            <action android:name="baidu.intent.action.account.OAUTH_ACTIVITY" />
        </intent>
    </queries>


    <application
        android:name=".DinnerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dinner"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dinner"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                union/oauth 的授权回调。redirect_uri 必须是
                dinner://oauth/callback，且与「百度后台配置」「发起授权」
                「换取 token」三处完全一致，否则换 token 会报 redirect_uri 不匹配。

                launchMode 必须是 singleTask：浏览器把应用从后台拉起来时
                才会走 onNewIntent，而不是再起一个实例（那样第二次授权收不到 code）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="dinner"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>